+static void ESCPID_restart_bookkeeping( int i ) {
+  AWPID_reset( );
+  ESCPID_Running[i]   = false;
+  ESCPID_Fresh[i]     = false;
+  ESCPID_Reference[i] = 0.0f;
+  ESCPID_Control[i]   = ESCPID_Min[i];   // never re-send a stale high throttle
